{
	"name": "monorepo",
	"version": "1.0.0",
	"description": "Monorepo for web app, Astro marketing site, and Starlight docs",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "npm run build --workspaces",
		"dev": "concurrently \"npm -w packages/design-system run dev\" \"npm -w apps/web run dev\" \"npm -w apps/marketing run dev\" \"npm -w apps/docs run dev\"",
		"dev:web": "npm -w apps/web run dev",
		"dev:marketing": "npm -w apps/marketing run dev",
		"dev:docs": "npm -w apps/docs run dev",
		"db:up": "docker compose up -d postgres",
		"start": "concurrently \"npm -w apps/web run start\" \"npm -w apps/marketing run start\" \"npm -w apps/docs run start\"",
		"start:web": "npm -w apps/web run start",
		"start:marketing": "npm -w apps/marketing run start",
		"start:docs": "npm -w apps/docs run start",
		"storybook": "npm -w packages/design-system run storybook",
		"build-storybook": "npm -w packages/design-system run build-storybook",
		"lint": "npm run lint --workspaces",
		"typecheck": "npm run typecheck --workspaces"
	},
	"devDependencies": {
		"concurrently": "^9.2.1",
		"vite": "^8.0.9"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"puppeteer-core": "^24.39.1",
		"react-router": "7.14.1"
	}
}
